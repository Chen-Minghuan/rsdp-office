# Copy this file to the project root as .env and fill locally.
# Docker Compose and the Java backend load the project root .env.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RSDP_VISION_MODEL=qwen3-vl-max
RSDP_REQUIREMENTS_SUMMARY_MODEL=qwen3-vl-plus
# Optional existing multipart recognition service; takes priority when non-empty.
RSDP_VISION_URL=
RSDP_VISION_REFINE_ROOM_CONTOURS=true

# Single-space concept images: native DashScope API (NOT /compatible-mode/v1).
# RSDP_RENDER_API_KEY is optional; falls back to DASHSCOPE_API_KEY.
# RSDP_RENDER_API_KEY=
RSDP_RENDER_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RSDP_RENDER_MODEL=qwen-image-3.0
# Pre-render product visual understanding uses DASHSCOPE_API_KEY and RSDP_VISION_MODEL.
RSDP_RENDER_PRODUCT_AGENT_ENABLED=true
RSDP_RENDER_PRODUCT_AGENT_MAX_NEW=4
# Experimental geometry-audit thresholds; calibrate with real generation samples.
RSDP_RENDER_GEOMETRY_AUDIT_CENTER_PASS_RATIO=0.04
RSDP_RENDER_GEOMETRY_AUDIT_CENTER_FAIL_RATIO=0.10
RSDP_RENDER_GEOMETRY_AUDIT_IOU_PASS=0.45
RSDP_RENDER_GEOMETRY_AUDIT_IOU_FAIL=0.20
RSDP_RENDER_GEOMETRY_AUDIT_MIN_CONFIDENCE=0.65
RSDP_RENDER_GEOMETRY_AUDIT_ROOM_IOU_PASS=0.75

# Main project (RSDP) connection: office reads the shared product catalog
# through a supplier service account provisioned in the main project.
RSDP_MAIN_BASE_URL=http://localhost:8081
RSDP_MAIN_USERNAME=
RSDP_MAIN_PASSWORD=
