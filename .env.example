# Docker Compose: copy to .env and fill locally.
# IDEA: configure these in the Java run configuration's Environment variables.
# Local Java startup does not automatically load this file or .env.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RSDP_VISION_MODEL=qwen3-vl-plus
# Optional existing multipart recognition service; takes priority when non-empty.
RSDP_VISION_URL=
RSDP_VISION_REFINE_ROOM_CONTOURS=true

# Single-space concept images: native DashScope API (NOT /compatible-mode/v1).
# RSDP_RENDER_API_KEY is optional; falls back to DASHSCOPE_API_KEY.
# RSDP_RENDER_API_KEY=
RSDP_RENDER_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RSDP_RENDER_MODEL=qwen-image-3.0
