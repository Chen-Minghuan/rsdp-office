# Docker Compose: copy to .env and fill locally.
# IDEA: configure these in the Java run configuration's Environment variables.
# Local Java startup does not automatically load this file or .env.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RSDP_VISION_MODEL=qwen3-vl-plus
# Optional existing multipart recognition service; takes priority when non-empty.
RSDP_VISION_URL=
