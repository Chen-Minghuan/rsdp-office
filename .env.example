# Copy this file to the project root as .env and fill locally.
# Docker Compose and the Java backend load the project root .env.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RSDP_VISION_MODEL=qwen3-vl-plus
# Optional existing multipart recognition service; takes priority when non-empty.
RSDP_VISION_URL=
