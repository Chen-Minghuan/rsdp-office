# Server-only configuration: install as /opt/rsdp-office/.env (root:jenkins 0640).
# Do not use the SSH password for the application or database.
RSDP_DATA_DIR=/opt/rsdp-office/data
RSDP_HTTP_PORT=3001
POSTGRES_DB=office
POSTGRES_USER=office
POSTGRES_PASSWORD=

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RSDP_VISION_MODEL=qwen3-vl-max
RSDP_VISION_URL=
RSDP_VISION_REFINE_ROOM_CONTOURS=true
RSDP_RENDER_API_KEY=
RSDP_RENDER_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RSDP_RENDER_MODEL=qwen-image-3.0

RSDP_AUTH_SECRET=
RSDP_AUTH_SESSION_TTL_SECONDS=43200
RSDP_AUTH_REMEMBER_TTL_SECONDS=2592000
RSDP_BOOTSTRAP_USERNAME=admin
RSDP_BOOTSTRAP_PASSWORD=
